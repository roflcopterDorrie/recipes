{
    "name": "roflcopterdorrie/recipes",
    "description": "A recipe module for Drupal that allows users to quickly create and manage recipes.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/roflcopterDorrie/php-pluralizer"
        }
    ],
    "require": {
        "opis/json-schema": "^2.0",
        "rachid/pluralizer": "^1.0",
        "php-units-of-measure/php-units-of-measure": "^2.1",
        "drupal/ai": "^1.3",
        "drupal/hook_event_dispatcher": "^4.2",
        "drupal/core_event_dispatcher": "^4.2",
        "drupal/views_event_dispatcher": "^4.2",
        "drupal/pathauto": "^1.15",
        "drupal/inline_entity_form": "^3.0@RC",
        "drupal/better_exposed_filters": "^7.1"
    }
}